source "https://rubygems.org"

# Mirrors the gem versions GitHub Pages builds with, so local previews match production.
gem "github-pages", group: :jekyll_plugins

# Faster local rebuilds while writing.
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
end

# Windows / newer Ruby compatibility shims (harmless on macOS).
gem "webrick", "~> 1.8"
